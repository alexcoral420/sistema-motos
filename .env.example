# Llave de la API externa /api (la consume n8n). El nombre es historico.
# Sin ella la API responde 503. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_WEBHOOK_KEY=
# Opcional, solo durante una rotacion: copiar aqui la llave vieja, poner la
# nueva arriba, cambiarla en n8n y borrar esta linea cuando el log deje de
# mostrar consumidor=n8n(anterior).
API_WEBHOOK_KEY_ANTERIOR=
# Web Push (recordatorios). Generar una vez; no cambiar en produccion
# (invalidaria todas las suscripciones existentes).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
